{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProductProblemCard",
  "type": "object",
  "required": ["problem_id","decision_status","product_problem_title","business_scenario","actor","current_standard_limitation","customer_variation_summary","root_product_gap","optimization_goal","proposed_product_capability","user_facing_recommendation","confidence","technical_evidence_refs"],
  "properties": {
    "problem_id": {"type": "string"},
    "decision_status": {"enum": ["ready_for_pm","needs_business_confirmation","technical_only","version_noise"]},
    "product_problem_title": {"type": "string", "minLength": 8},
    "business_scenario": {"type": "string"},
    "actor": {"type": "string"},
    "current_standard_limitation": {"type": "string"},
    "business_impact": {"type": "string"},
    "customer_variation_summary": {"type": "array", "items": {"type": "object", "required": ["customer","business_behavior"], "properties": {"customer": {"type": "string"}, "business_behavior": {"type": "string"}, "evidence_strength": {"enum": ["high","medium","low"]}}}},
    "root_product_gap": {"type": "string"},
    "optimization_goal": {"type": "string"},
    "proposed_product_capability": {"type": "string"},
    "mvp_scope": {"type": "array", "items": {"type": "string"}},
    "business_value": {"type": "array", "items": {"type": "string"}},
    "internal_recommendation_code": {"enum": ["strong_productization_candidate","productization_candidate","configuration_candidate","observe","keep_custom"]},
    "user_facing_recommendation": {"type": "string"},
    "evidence_customers": {"type": "array", "items": {"type": "string"}},
    "counter_evidence": {"type": "array", "items": {"type": "string"}},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "confidence": {"enum": ["high","medium","low"]},
    "baseline_quality": {"enum": ["high","medium","low","mixed","unknown"]},
    "technical_evidence_refs": {"type": "array", "items": {"type": "string"}}
  }
}