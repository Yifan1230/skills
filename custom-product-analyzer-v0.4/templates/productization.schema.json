{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProductizationOpportunity",
  "type": "object",
  "required": [
    "feature_id",
    "product_problem_id",
    "recommendation",
    "recommendation_label_cn",
    "confidence",
    "rationale",
    "evidence"
  ],
  "properties": {
    "feature_id": {"type": "string"},
    "product_problem_id": {"type": "string"},
    "recommendation": {
      "enum": [
        "strong_productization_candidate",
        "productization_candidate",
        "configuration_candidate",
        "observe",
        "keep_custom"
      ]
    },
    "recommendation_label_cn": {"type": "string"},
    "rationale": {"type": "string"},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "counter_evidence": {"type": "array", "items": {"type": "object"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "human_confirmation_needed": {"type": "array", "items": {"type": "string"}},
    "technical_only": {"type": "boolean", "default": false}
  }
}
